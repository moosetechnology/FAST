"
Use me to generate the MetaModel of FAST

NOTE: I generate the Core FAST Model and the Java FAST Model because we can't currently do `resetMetadata` with extended metamodel generated by FamixNG
"
Class {
	#name : 'FASTMetamodelGenerator',
	#superclass : 'FamixMetamodelGenerator',
	#instVars : [
		'entity',
		'tWithArguments',
		'tWithParameters',
		'tEntity',
		'tExpression',
		'tLiteral',
		'tBooleanLiteral',
		'tCharacterLiteral',
		'tNullPointerLiteral',
		'tStringLiteral',
		'tVariableExpression',
		'tScopableEntity',
		'tBehaviouralEntity',
		'tNamedBehaviouralEntity',
		'tStatement',
		'tExpressionStatement',
		'tReturnStatement',
		'tStatementBlock',
		'tNamedEntity',
		'tInvocation',
		'tNumericalLiteral',
		'tAssignment',
		'tVariableEntity',
		'tComment',
		'tWithComments',
		'tBinaryExpression',
		'tUnaryExpression',
		'tConditionalStatement',
		'tLoopStatement',
		'tBranchStatement',
		'tLabeledStatement',
		'tGotoStatement'
	],
	#category : 'FAST-Model-Generator',
	#package : 'FAST-Model-Generator'
}

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTAssignment [
	^ 'A node representing an assignment'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTBehaviouralEntity [
	^ 'Represents a generic behavioural entity which has parameters and local variables, as well as statements. 

Can represent a SmalltalkBlock, or a JavaLambda
Subclassed for NamedBehavioural as methods/functions

Has parameters , and a body (StatementBlock).
Local variables are intended to be stored in the local entities of the body'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTBinaryExpression [
	^ 'A trait representing a binary expression of a node of a source code.'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTBooleanLiteral [
	^ 'A boolean literal'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTCharacterLiteral [
	^ 'A character literal'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTComment [

	^ 'FASTComment represents one instance of a comment (in the sense of programming language comments) for any FAST sourced entity. The commented sourced entity is called the container in the FAST model.'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTEntity [
	^ 'A FASTEntity is an abstract class for all FAST classes

Primarily introduced to deal with symbol resolution matters.'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTExpression [
	^ 'An abstract superclass representing an expression node of a source code.'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTExpressionStatement [
	^ 'A node of a statement which is representing a single expression. '
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTInvocation [
	^ 'A invocation of a behavioural entity'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTLiteral [
	^ 'A literal node.

Contains a value for the literal.

FLAG: should refactor some literals to core-model
    e.g.: character, int, float, string, boolean '
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTNamedBehaviouralEntity [
	^ '@FLAG: May be could be removed to have a simpler core model.
Each language would have to implement it correctly then

A behavioural entity that can be referenced with a name.

Assumed to correspond to a function or a method'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTNullPointerLiteral [
	^ 'An undefined object literal'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTNumericalLiteral [
	^ 'A numerical literal'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTReturnStatement [
	^ 'A return statement node. Contains a reference to the expression which is returned.  '
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTScopableEntity [
	^ 'A Entity with an optional scope

Some statements are scopable because they allow to introduce local variables (e.g. for statement in Java)'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTStatement [
	^ 'An abstract subclass which represents a source code statemnet '
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTStatementBlock [
	^ 'A block of statements as ones in C-like langs with {}'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTStringLiteral [
	^ 'A string literal'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTUnaryExpression [
	^ 'A trait representing an unary expression of a node of a source code.'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTVariableEntity [
	^ 'A node for variable name not in a expression (example: assigned variable or parameter)'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTVariableExpression [
	^ 'A node that wraps around structural entity'
]

{ #category : 'comments' }
FASTMetamodelGenerator class >> commentForTWithComments [

	^ ' For entities with comments. In FAST, they are called containers. '
]

{ #category : 'accessing' }
FASTMetamodelGenerator class >> packageName [

	^ #'FAST-Core-Model'
]

{ #category : 'accessing' }
FASTMetamodelGenerator class >> prefix [
	^ #FAST
]

{ #category : 'accessing' }
FASTMetamodelGenerator class >> submetamodels [ 
	^ { FamixGenerator }
]

{ #category : 'definition' }
FASTMetamodelGenerator >> defineClasses [
	super defineClasses.
	entity := builder newClassNamed: #Entity comment: 'any entity'. 
]

{ #category : 'definition' }
FASTMetamodelGenerator >> defineHierarchy [
	super defineHierarchy.

	tEntity --|> #TEntityMetaLevelDependency.
	tExpression --|> tEntity.
	entity --|> tEntity.
	
	tLiteral --|> tExpression.
	tBinaryExpression --|> tExpression.
	tUnaryExpression --|> tExpression.
	
	tBooleanLiteral --|> tLiteral.
	tCharacterLiteral --|> tLiteral.
	tNullPointerLiteral --|> tLiteral.
	tStringLiteral --|> tLiteral.
	tNumericalLiteral --|> tLiteral.
	tVariableExpression --|> tExpression.
	tScopableEntity --|> tEntity.
	
	tBehaviouralEntity --|> tScopableEntity.
	tBehaviouralEntity --|> tWithParameters.

	tStatement --|> tEntity.
	tBranchStatement --|> tStatement.
	tConditionalStatement --|> tBranchStatement.
	tExpressionStatement --|> tStatement.
	tGotoStatement --|> tStatement.
	tLoopStatement --|> tBranchStatement.
	tNamedBehaviouralEntity --|> tBehaviouralEntity.
	tReturnStatement --|> tStatement.
	tStatementBlock --|> tStatement.
	
	tVariableExpression --|> tNamedEntity.
	tVariableEntity --|> tNamedEntity.
	tNamedBehaviouralEntity --|> tNamedEntity.
	
	tAssignment --|> tExpression.
	
	tInvocation --|> tExpression.
	tInvocation --|> tWithArguments.
	
	tNamedEntity --|> tEntity.
]

{ #category : 'definition' }
FASTMetamodelGenerator >> defineProperties [

	super defineProperties.
	(tLiteral property: #primitiveValue type: #String) comment:
		'The literal itself as found in the source code. We use primitiveValue in order to override value from Object'.

	tEntity
		property: #startPos type: #Number;
		property: #endPos type: #Number.

	tGotoStatement property: #label type: #String.
	
	tNamedEntity property: #name type: #String.
	
	((tComment property: #content type: #String) 
		comment: 'Content of the comment as a String').

	(tUnaryExpression property: #operator type: #String) comment:
		'Unary expression operator'.

	(tBinaryExpression property: #operator type: #String) comment:
		'Binary expression operator'.

]

{ #category : 'definition' }
FASTMetamodelGenerator >> defineRelations [
	super defineRelations.

	((tAssignment property: #expression) comment: 'Assigned expression (rhs of assignment)')
	<>- ((tExpression property: #assignedIn)
		comment: 'Optional assignment where this expression is used').

	((tAssignment property: #variable) comment: 'An assigned variable (lhs of assignment)')
	<>- ((tVariableEntity property: #parentAssignmentExpression)
		comment: 'Optional assignment to the variable').

	(((tBehaviouralEntity property: #statementBlock) comment: 'Statements block of the behavioural entity')
	<>- ((tStatementBlock property: #fastBehaviouralParent)
		comment: 'Behavioural entity containing the statement block.')) .

	((tBinaryExpression property: #leftOperand) comment: 'left part of a binary expression')
	<>- ((tExpression property: #parentExpressionLeft)
		comment: 'Parent (binary) expression of which I am left side').

	((tBinaryExpression property: #rightOperand) comment: 'left part of the expression')
	<>- ((tExpression property: #parentExpressionRight)
		comment: 'Parent (binary) expression of which I am right side').

	((tBranchStatement property: #expression) comment: 'The expression commanding which branch is executed')
	<>- ((tExpression property: #parentBranchStatement)
		comment: 'Branch statement that I "command"').

	((tBranchStatement property: #branches) comment: 'The various children branches of this BranchStatement')
	<>-* ((tStatement property: #parentBranchStatement)
		comment: 'My parent BranchStatement (of which I am a branch)').

	((tComment property: #container) comment: 'Source code entity containing the comment')
		*-<> ((tWithComments property: #comments)
			comment: 'list of comments defined in the entity').

	"((tConditionalStatement property: #condition) comment: 'The boolean condition tested')
	<>- ((tExpression property: #parentConditionalStatement) comment: 'Optional condition statement where this expression is used')."

	(((tExpressionStatement property: #expression) comment: 'The expression of the statement')
	<>- ((tExpression property: #expressionStatementOwner)
		comment: 'The expression statement that own me (if it''s the case')) .

	((tInvocation property: #invoked) comment: 'The name of the behavioural invoked')
	<>- ((tNamedEntity property: #invokedIn) comment: 'Optional invocation where this name is used').

	"((tLoopStatement property: #body) comment: 'The body of the loop')
	<>- ((tStatement property: #parentLoopStatement) comment: 'Optional loop of which this statement is the body')."

	(((tReturnStatement property: #expression) comment: 'The expression returned')
	<>- ((tExpression property: #returnOwner)
		comment: 'The return statement that own the expression (if it''s the case)')) .

	(((tStatement property: #statementContainer) comment: 'Block containing this statement.')
	*-<> ((tStatementBlock property: #statements) comment: 'Statements enclosed in this block')) .

	((tUnaryExpression property: #expression) comment: '(sub-)expression in the unary expression')
	<>- ((tExpression property: #parentExpression) comment: 'Parent (unary) expression').

	((tWithParameters property: #parameters) comment: 'My parameters')
	<>-* ((tVariableEntity property: #parameterOwner) comment: 'parameterOwner') . 

	((tWithArguments property: #arguments) comment: 'My arguments')
	<>-* ((tExpression property: #argumentOwner) comment: 'my owner') .

]

{ #category : 'definition' }
FASTMetamodelGenerator >> defineTraits [
	super defineTraits.

	tAssignment := builder newTraitNamed: #TAssignment comment: FASTMetamodelGenerator commentForTAssignment.
	tAssignment withTesting.
	tBehaviouralEntity := builder newTraitNamed: #TBehaviouralEntity comment: FASTMetamodelGenerator commentForTBehaviouralEntity.
	tBehaviouralEntity withTesting.
	tBinaryExpression := builder newTraitNamed: #TBinaryExpression comment: FASTMetamodelGenerator commentForTBinaryExpression.
	tBinaryExpression withTesting.
	tBooleanLiteral := builder newTraitNamed: #TBooleanLiteral comment: FASTMetamodelGenerator commentForTBooleanLiteral.
	tBooleanLiteral withTesting.
	tBranchStatement := builder newTraitNamed: #TBranchStatement comment: 'I represent any statement that has several branches of execution (eg. swithcStatement, ifStatement)'.
	tCharacterLiteral := builder newTraitNamed: #TCharacterLiteral comment: FASTMetamodelGenerator commentForTCharacterLiteral.
	tCharacterLiteral withTesting.
	tComment := builder newTraitNamed: #TComment.
	tComment comment: FASTMetamodelGenerator commentForTComment.
	tConditionalStatement := builder newTraitNamed: #TConditionalStatement comment: 'I represent any statement that has a boolean condition (eg. ifStatement)'.
	tEntity := builder newTraitNamed: #TEntity comment: 'any entity'.
	tExpression := builder newTraitNamed: #TExpression comment: FASTMetamodelGenerator commentForTExpression.
	tExpression withTesting.
	tExpressionStatement := builder newTraitNamed: #TExpressionStatement comment: FASTMetamodelGenerator commentForTExpressionStatement.
	tExpressionStatement withTesting.
	tGotoStatement := builder newTraitNamed: #TGotoStatement comment: 'I represent an unconditional jump statement (ie. a GOTO)'.
	tInvocation := builder newTraitNamed: #TInvocation comment: FASTMetamodelGenerator commentForTInvocation.
	tInvocation withTesting.
	tLabeledStatement := builder newTraitNamed: #TLabeledStatement comment: 'I represent a statement that is labeled (can be target of a GOTO)'.
	tLiteral := builder newTraitNamed: #TLiteral comment: FASTMetamodelGenerator commentForTLiteral.
	tLiteral withTesting.
	tLoopStatement := builder newTraitNamed: #TLoopStatement comment: 'I represent any loop statement (for, while...)'.
	tNamedEntity := builder newTraitNamed: #TNamedEntity comment: 'A entity with a name'.
	tNamedBehaviouralEntity := builder newTraitNamed: #TNamedBehaviouralEntity comment: FASTMetamodelGenerator commentForTNamedBehaviouralEntity.
	tNullPointerLiteral := builder newTraitNamed: #TNullPointerLiteral comment: FASTMetamodelGenerator commentForTNullPointerLiteral.
	tNullPointerLiteral withTesting.
	tNumericalLiteral := builder newTraitNamed: #TNumericalLiteral comment: FASTMetamodelGenerator commentForTNumericalLiteral.
	tNumericalLiteral withTesting.
	tReturnStatement := builder newTraitNamed: #TReturnStatement comment: FASTMetamodelGenerator commentForTReturnStatement.
	tReturnStatement withTesting.
	tScopableEntity := builder newTraitNamed: #TScopableEntity comment: FASTMetamodelGenerator commentForTScopableEntity.
	tScopableEntity withTesting.
	tStatement := builder newTraitNamed: #TStatement comment: FASTMetamodelGenerator commentForTStatement.
	tStatement withTesting.
	tStatementBlock := builder newTraitNamed: #TStatementBlock comment: FASTMetamodelGenerator commentForTStatementBlock.
	tStatementBlock withTesting.
	tStringLiteral := builder newTraitNamed: #TStringLiteral comment: FASTMetamodelGenerator commentForTStringLiteral.
	tStringLiteral withTesting.
	tUnaryExpression := builder newTraitNamed: #TUnaryExpression comment: FASTMetamodelGenerator commentForTUnaryExpression.
	tUnaryExpression withTesting.
	tVariableEntity := builder newTraitNamed: #TVariableEntity comment: FASTMetamodelGenerator commentForTVariableEntity.
	tVariableEntity withTesting.
	tVariableExpression := builder newTraitNamed: #TVariableExpression comment: FASTMetamodelGenerator commentForTVariableExpression.
	tVariableExpression withTesting.
	tWithArguments := builder newTraitNamed: #TWithArguments comment: 'I have arguments'. 
	tWithComments := builder newTraitNamed: #TWithComments.
	tWithComments comment: FASTMetamodelGenerator commentForTWithComments.
	tWithParameters := builder newTraitNamed: #TWithParameters comment: 'I have parameters'.
]
