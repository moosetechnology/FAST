SmalltalkCISpec {
   #testing : {
    #coverage : {
      #packages : [ 'FAST-Core-Model', 'FAST-Core-Model-Extension', 'FAST-Core-Tools', 'FAST-Core-Visitor' ],
      #format : #lcov
    }
  },
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'FAST',
      #directory : 'src',
      #load : [ 'core', 'tools' ],
      #platforms : [ #pharo ]
    }
  ]
}
